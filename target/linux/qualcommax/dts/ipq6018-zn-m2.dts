// SPDX-License-Identifier: GPL-2.0-or-later OR MIT
/*
 * ZN M2 board support
 *
 * Based on vendor DTS from AmadeusGhost <amadeus@jmu.edu.cn>
 * Ported to mainline ipq6018 PPE/EDMA bindings.
 */

/dts-v1/;

#include "ipq6018.dtsi"
#include "ipq6018-cp-cpu.dtsi"
#include "ipq6018-ess.dtsi"
#include <dt-bindings/gpio/gpio.h>
#include <dt-bindings/input/input.h>
#include <dt-bindings/leds/common.h>

/ {
	model = "ZN M2";
	compatible = "zn,m2", "qcom,ipq6018";

	aliases {
		led-boot = &led_power;
		led-failsafe = &led_power;
		led-running = &led_power;
		led-upgrade = &led_power;
		serial0 = &blsp1_uart3;
	};

	chosen {
		stdout-path = "serial0:115200n8";
		bootargs-append = " ubi.mtd=rootfs root=/dev/ubiblock0_1";
	};

	keys {
		compatible = "gpio-keys";
		pinctrl-0 = <&button_pins>;
		pinctrl-names = "default";

		reset {
			label = "reset";
			gpios = <&tlmm 60 GPIO_ACTIVE_LOW>;
			linux,code = <KEY_RESTART>;
			debounce-interval = <60>;
		};

		wps {
			label = "wps";
			gpios = <&tlmm 9 GPIO_ACTIVE_LOW>;
			linux,code = <KEY_WPS_BUTTON>;
			debounce-interval = <60>;
		};
	};

	leds {
		compatible = "gpio-leds";
		pinctrl-0 = <&leds_pins>;
		pinctrl-names = "default";

		led_power: power {
			function = LED_FUNCTION_POWER;
			color = <LED_COLOR_ID_BLUE>;
			gpios = <&tlmm 58 GPIO_ACTIVE_HIGH>;
			default-state = "on";
		};

		mesh {
			function = LED_FUNCTION_WLAN;
			color = <LED_COLOR_ID_BLUE>;
			gpios = <&tlmm 73 GPIO_ACTIVE_HIGH>;
		};

		lan {
			function = LED_FUNCTION_LAN;
			color = <LED_COLOR_ID_BLUE>;
			gpios = <&tlmm 74 GPIO_ACTIVE_HIGH>;
		};

		wan {
			function = LED_FUNCTION_WAN;
			color = <LED_COLOR_ID_BLUE>;
			gpios = <&tlmm 37 GPIO_ACTIVE_HIGH>;
		};

		wlan5g {
			function = LED_FUNCTION_WLAN_5GHZ;
			color = <LED_COLOR_ID_BLUE>;
			gpios = <&tlmm 35 GPIO_ACTIVE_HIGH>;
		};

		wlan2g {
			function = LED_FUNCTION_WLAN_2GHZ;
			color = <LED_COLOR_ID_BLUE>;
			gpios = <&tlmm 70 GPIO_ACTIVE_HIGH>;
		};
	};
};

/*
 * NSS/Q6 reserved region: the upstream default is 0x5500000 (ends exactly
 * at 0x50000000), which eats most of the usable RAM on this 256 MiB board.
 * This image ships no Q6/NSS firmware, so shrink it like the cp01 reference.
 */
&q6_region {
	reg = <0x0 0x4ab00000 0x0 0x2000000>;
};

&tlmm {
	button_pins: button-pins {
		wps-button {
			pins = "gpio9";
			function = "gpio";
			drive-strength = <8>;
			bias-pull-up;
		};

		reset-button {
			pins = "gpio60";
			function = "gpio";
			drive-strength = <8>;
			bias-pull-up;
		};
	};

	leds_pins: leds-pins {
		mux {
			pins = "gpio35", "gpio37", "gpio58",
			       "gpio70", "gpio73", "gpio74";
			function = "gpio";
			drive-strength = <8>;
			bias-pull-down;
		};
	};

	mdio_pins: mdio-pins {
		mdc {
			pins = "gpio64";
			function = "mdc";
			drive-strength = <8>;
			bias-pull-up;
		};

		mdio {
			pins = "gpio65";
			function = "mdio";
			drive-strength = <8>;
			bias-pull-up;
		};

		phy-reset {
			pins = "gpio75", "gpio77";
			function = "gpio";
			bias-pull-up;
		};
	};
};

&edma {
	status = "okay";
};

&uniphy0 {
	status = "okay";
};

&switch {
	status = "okay";

	ports {
		#address-cells = <1>;
		#size-cells = <0>;

		port@0 {
			reg = <0>;
			ethernet = <&edma>;
			phy-mode = "internal";

			fixed-link {
				speed = <1000>;
				full-duplex;
			};
		};

		swport1: port@1 {
			reg = <1>;
			label = "lan1";
			phy-handle = <&phy0>;
			phy-mode = "psgmii";
			pcs-handle = <&uniphy0 0>;
		};

		swport2: port@2 {
			reg = <2>;
			label = "lan2";
			phy-handle = <&phy1>;
			phy-mode = "psgmii";
			pcs-handle = <&uniphy0 1>;
		};

		swport4: port@4 {
			reg = <4>;
			label = "lan3";
			phy-handle = <&phy3>;
			phy-mode = "psgmii";
			pcs-handle = <&uniphy0 3>;
		};

		swport5: port@5 {
			reg = <5>;
			label = "wan";
			phy-handle = <&phy4>;
			phy-mode = "psgmii";
			pcs-handle = <&uniphy0 4>;
		};
	};
};

&mdio {
	status = "okay";

	pinctrl-0 = <&mdio_pins>;
	pinctrl-names = "default";
	reset-gpios = <&tlmm 75 GPIO_ACTIVE_LOW>;
	reset-delay-us = <10000>;
	reset-post-delay-us = <50000>;

	ethernet-phy-package {
		#address-cells = <1>;
		#size-cells = <0>;
		compatible = "qcom,qca8075-package";
		reg = <0>;

		qcom,package-mode = "psgmii";

		phy0: ethernet-phy@0 {
			compatible = "ethernet-phy-ieee802.3-c22";
			reg = <0>;
		};

		phy1: ethernet-phy@1 {
			compatible = "ethernet-phy-ieee802.3-c22";
			reg = <1>;
		};

		phy2: ethernet-phy@2 {
			compatible = "ethernet-phy-ieee802.3-c22";
			reg = <2>;
		};

		phy3: ethernet-phy@3 {
			compatible = "ethernet-phy-ieee802.3-c22";
			reg = <3>;
		};

		phy4: ethernet-phy@4 {
			compatible = "ethernet-phy-ieee802.3-c22";
			reg = <4>;
		};
	};
};

&blsp1_uart3 {
	pinctrl-0 = <&serial_3_pins>;
	pinctrl-names = "default";
	status = "okay";
};

&prng {
	status = "okay";
};

&qpic_bam {
	status = "okay";
};

&qpic_nand {
	status = "okay";

	nand@0 {
		reg = <0>;
		nand-ecc-strength = <4>;
		nand-ecc-step-size = <512>;
		nand-bus-width = <8>;

		partitions {
			/*
			 * The APPSBL of this board exports the full 19 partition
			 * layout through SMEM, so do not hardcode it here.
			 */
			compatible = "qcom,smem-part";

			partition-0-appsblenv {
				label = "0:appsblenv";

				nvmem-layout {
					compatible = "u-boot,env";
					env-size = <0x40000>;
				};
			};
		};
	};
};
